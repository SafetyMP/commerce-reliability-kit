{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "report-1.1.0",
  "type": "object",
  "properties": {
    "sources": {
      "$ref": "evidence-1.1.0#/properties/sources"
    },
    "policy": {
      "$ref": "evidence-1.1.0#/properties/policy"
    },
    "outcomes": {
      "$ref": "evidence-1.1.0#/properties/outcomes"
    },
    "schemaVersion": {
      "const": "1.1.0"
    },
    "manifest": {
      "type": "object",
      "properties": {
        "toolVersion": {
          "const": "0.1.0"
        },
        "schemaVersion": {
          "const": "1.1.0"
        },
        "scenarioId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:/-]+$",
          "minLength": 1,
          "maxLength": 160
        },
        "scenarioVersion": {
          "const": "1.0.0"
        },
        "ruleVersion": {
          "enum": ["1.1.0", "1.1.1"]
        },
        "importerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "profileVersion": {
          "const": "1.0.0"
        },
        "mappingVersions": {
          "type": "array",
          "items": {
            "const": "1.0.0"
          },
          "maxItems": 1000000
        },
        "inputHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policyHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evaluationTime": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,3})?Z$"
        },
        "mode": {
          "enum": [
            "demo",
            "assert",
            "analyze"
          ]
        },
        "reproductionCommand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "toolVersion",
        "schemaVersion",
        "scenarioId",
        "scenarioVersion",
        "ruleVersion",
        "importerVersion",
        "profileVersion",
        "mappingVersions",
        "inputHash",
        "policyHash",
        "evaluationTime",
        "mode",
        "reproductionCommand"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:/-]+$",
            "minLength": 1,
            "maxLength": 160
          },
          "ruleVersion": {
            "enum": ["1.1.0", "1.1.1"]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:/-]+$",
              "minLength": 1,
              "maxLength": 160
            },
            "maxItems": 1000000,
            "minItems": 1
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:/-]+$",
              "minLength": 1,
              "maxLength": 160
            },
            "maxItems": 1000000
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "interpretation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "uncertainty": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "maxItems": 1000000
          },
          "blockingPrerequisites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "maxItems": 1000000
          }
        },
        "required": [
          "ruleId",
          "ruleVersion",
          "evidence",
          "entities",
          "severity",
          "interpretation",
          "uncertainty",
          "blockingPrerequisites"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000000
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:/-]+$",
            "minLength": 1,
            "maxLength": 160
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "INCONCLUSIVE",
              "NOT APPLICABLE"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:/-]+$",
              "minLength": 1,
              "maxLength": 160
            },
            "maxItems": 1000000
          },
          "expected": {
            "type": "string"
          },
          "observed": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        },
        "required": [
          "id",
          "status",
          "required",
          "reason",
          "evidence",
          "expected",
          "observed",
          "details"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000000
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:/-]+$",
            "minLength": 1,
            "maxLength": 160
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "INCONCLUSIVE",
              "NOT APPLICABLE"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:/-]+$",
              "minLength": 1,
              "maxLength": 160
            },
            "maxItems": 1000000
          },
          "expected": {
            "type": "string"
          },
          "observed": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        },
        "required": [
          "id",
          "status",
          "required",
          "reason",
          "evidence",
          "expected",
          "observed",
          "details"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000000
    },
    "integrationAssertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:/-]+$",
            "minLength": 1,
            "maxLength": 160
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "INCONCLUSIVE",
              "NOT APPLICABLE"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:/-]+$",
              "minLength": 1,
              "maxLength": 160
            },
            "maxItems": 1000000
          },
          "expected": {
            "type": "string"
          },
          "observed": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        },
        "required": [
          "id",
          "status",
          "required",
          "reason",
          "evidence",
          "expected",
          "observed",
          "details"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000000
    },
    "summary": {
      "type": "object",
      "properties": {
        "diagnostics": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "required": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "PASS": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "FAIL": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "INCONCLUSIVE": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "NOT APPLICABLE": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "total",
            "required",
            "PASS",
            "FAIL",
            "INCONCLUSIVE",
            "NOT APPLICABLE"
          ],
          "additionalProperties": false
        },
        "assertions": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "required": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "PASS": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "FAIL": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "INCONCLUSIVE": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "NOT APPLICABLE": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "total",
            "required",
            "PASS",
            "FAIL",
            "INCONCLUSIVE",
            "NOT APPLICABLE"
          ],
          "additionalProperties": false
        },
        "integrationAssertions": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "required": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "PASS": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "FAIL": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "INCONCLUSIVE": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "NOT APPLICABLE": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "total",
            "required",
            "PASS",
            "FAIL",
            "INCONCLUSIVE",
            "NOT APPLICABLE"
          ],
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "complete": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "declared": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "total",
            "complete",
            "declared"
          ],
          "additionalProperties": false
        },
        "exitCode": {
          "enum": [
            0,
            1,
            2,
            3
          ]
        }
      },
      "required": [
        "diagnostics",
        "assertions",
        "integrationAssertions",
        "coverage",
        "exitCode"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "$ref": "evidence-1.1.0#/properties/coverage"
    },
    "observations": {
      "$ref": "evidence-1.1.0#/properties/observations"
    },
    "transformations": {
      "$ref": "evidence-1.1.0#/properties/mappings"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "maxItems": 1000000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "maxItems": 1000000
    }
  },
  "required": [
    "sources",
    "policy",
    "outcomes",
    "schemaVersion",
    "manifest",
    "findings",
    "checks",
    "assertions",
    "integrationAssertions",
    "summary",
    "coverage",
    "observations",
    "transformations",
    "assumptions",
    "limitations"
  ],
  "additionalProperties": false
}
